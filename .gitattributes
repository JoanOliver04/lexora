# Normaliza los finales de línea: LF en el repositorio, siempre.
# Sin esto, un checkout en Windows convierte a CRLF y ficheros como .nvmrc,
# los scripts de shell y las migraciones SQL fallan al ejecutarse en la CI.
* text=auto eol=lf

# Ficheros que deben conservar LF de forma explícita.
*.sh      text eol=lf
*.sql     text eol=lf
.nvmrc    text eol=lf

# Binarios: nunca se tocan.
*.png     binary
*.jpg     binary
*.webp    binary
*.ico     binary
*.woff    binary
*.woff2   binary
*.pdf     binary

# Ficheros generados versionados. El lockfile conserva un diff de texto para
# revisar los cambios de dependencias, aunque GitHub lo agrupe como generado.
pnpm-lock.yaml       linguist-generated=true
database.types.ts    linguist-generated=true
