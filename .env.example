# =====================================================================
#  Lexora — plantilla de variables de entorno
#
#  Copia este archivo a `.env.local` y rellena los valores.
#  NUNCA pongas valores reales aquí: este archivo SÍ se versiona.
#
#  Esquemas: src/env/server.ts y src/env/client.ts
# =====================================================================

# ---------------------------------------------------------------------
#  Cliente — PÚBLICO
#
#  Next.js sustituye estas variables por su valor literal al construir, así
#  que acaban dentro del JavaScript que descarga cualquier visitante.
#  Ponerle el prefijo NEXT_PUBLIC_ a un secreto no lo protege: lo publica.
# ---------------------------------------------------------------------

# URL pública de la aplicación. En local puede omitirse.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------
#  Servidor — PRIVADO
#
#  Nunca llegan al navegador. `src/env/server.ts` importa `server-only`,
#  de modo que usarlas desde un componente de cliente rompe el build.
# ---------------------------------------------------------------------

# NODE_ENV lo gestiona Next.js; no hace falta definirlo a mano.

# Supabase: se añadirán en LEX-1.7, cuando exista el proyecto local.
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# ---------------------------------------------------------------------
#  Escotilla
#
#  Salta la validación. Solo para pasos que compilan sin ejecutar nada,
#  como un build en CI sin acceso a las variables de producción.
#  Jamás en un entorno que sirva tráfico.
# ---------------------------------------------------------------------
# SKIP_ENV_VALIDATION="true"
