# =====================================================================
#  Lexora — .gitignore
#  El repositorio es PÚBLICO. Todo lo que no aparezca aquí se publica.
# =====================================================================

# --- Documentación de gobierno privada -------------------------------
# La especificación maestra y el roadmap contienen el diseño completo del
# producto y no se publican para evitar que se copien. El resto de la
# documentación (STATUS, OPEN_QUESTIONS, ADR, evidence) sí es pública.
# También queda aquí el material privado de Anki usado para pruebas.
no_visible_en_github/

# --- Entorno y secretos ----------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
.supabase/
supabase/.temp/
supabase/.branches/

# --- Dependencias y build --------------------------------------------
node_modules/
.pnpm-store/
.pnp
.pnp.*
.next/
out/
build/
dist/
coverage/
*.tsbuildinfo

# Lo regenera Next.js en cada build; no se versiona.
next-env.d.ts

# --- Registros de depuracion -----------------------------------------
npm-debug.log*
yarn-debug.log*
.pnpm-debug.log*

# --- Herramientas y artefactos de test -------------------------------
.vercel/
playwright-report/
test-results/
blob-report/
.playwright/

# --- Sistema operativo y editores ------------------------------------
Thumbs.db
Desktop.ini
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
